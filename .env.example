# ==============================================================================
# 👑 REXONE MOBILE — APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Organized strictly by operational priority and architectural tiers:
#
#   🟢 TIER 1: CRITICAL RUNTIME & APIS (Required for Flutter app to launch & connect)
#   🟡 TIER 2: BRANDING & PUBLIC METADATA (App names, bundle IDs, support email)
#   🟠 TIER 3: AUTHENTICATION & NOTIFICATIONS (Google OAuth, OneSignal push)
#   🟣 TIER 4: OFFLINE ENCRYPTION & MEDIA CACHE (Local secure storage salt & keys)
#   ⚪ TIER 5: DEPLOYMENT PRESETS & FALLBACKS (Commented deployment presets)
# ==============================================================================


# ==============================================================================
# 🟢 TIER 1: CRITICAL RUNTIME & APIS
# ==============================================================================

# Active environment file name loaded via AppConfig (.env.dev, .env.uat, or .env.prod)
APP_ENV=.env.dev

# Backend API Base URL (Do NOT include trailing slash)
#   - Local Dev: http://localhost:3000 (iOS Simulator) or http://10.0.2.2:3000 (Android Emulator)
#   - Production: https://api.rexone.com
API_BASE_URL=https://api.rexone.com


# ==============================================================================
# 🟡 TIER 2: BRANDING & PUBLIC METADATA
# ==============================================================================

APP_NAME=RexOne
APP_VERSION=1.0.0
ANDROID_APP_ID=com.rex9.rexone
IOS_APP_ID=com.rex9.rexone
FROM_EMAIL=support@rexone.com


# ==============================================================================
# 🟠 TIER 3: AUTHENTICATION & NOTIFICATIONS
# ==============================================================================

# Google Sign-In Web / Server Client ID for backend token exchange
GOOGLE_SERVER_CLIENT_ID=changeme_google_server_client_id.apps.googleusercontent.com

# OneSignal Push Notifications
ONE_SIGNAL_APP_ID=changeme_onesignal_app_id
ONESIGNAL_DISABLE_LOCATION=true


# ==============================================================================
# 🟣 TIER 4: OFFLINE ENCRYPTION & MEDIA CACHE
# ==============================================================================

# 32-byte encryption key for local cached media and secure storage
MEDIA_OFFLINE_ENCRYPTION_KEY=changeme_media_offline_encryption_key_32_bytes


# ==============================================================================
# ⚪ TIER 5: DEPLOYMENT PRESETS & FALLBACKS
# ==============================================================================

# ------------------------------------------------------------------------------
# API Base URL Presets
# ------------------------------------------------------------------------------
# Production: API_BASE_URL=https://api.rexone.com
# UAT:        API_BASE_URL=https://uat.api.rexone.com
# Local iOS:  API_BASE_URL=http://localhost:3000
# Local Droid:API_BASE_URL=http://10.0.2.2:3000
